#!/bin/sh
set -eu

APP="/usr/lib/spanda/spanda"

if [ ! -x "$APP" ]; then
    echo "Spanda is not installed correctly: $APP is missing." >&2
    exit 1
fi

if [ -z "${DISPLAY:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    # DearPyGUI uses GLFW/X11. Plasma Wayland normally provides XWayland; if
    # DISPLAY was not exported, discover a live X socket.
    for n in 0 1 2 3 4 5 6 7; do
        if [ -S "/tmp/.X11-unix/X$n" ]; then
            DISPLAY=":$n"
            export DISPLAY
            break
        fi
    done
fi

if [ -z "${DISPLAY:-}" ]; then
    echo "Spanda needs a graphical X11 or XWayland session." >&2
    echo "Start Spanda from a desktop session, or enable XWayland on Plasma Wayland." >&2
    exit 1
fi

if command -v glxinfo >/dev/null 2>&1; then
    if ! glxinfo -B >/dev/null 2>&1; then
        echo "Warning: glxinfo could not confirm OpenGL; Spanda will still try to start." >&2
    fi
elif ! ldconfig -p 2>/dev/null | grep -q 'libGL.so.1'; then
    echo "Spanda needs Mesa/OpenGL (libGL.so.1). Install mesa-utils or libgl1." >&2
    exit 1
fi

exec "$APP" "$@"
